# ==============================================================================
# BATU YEHIYWOT BERHAN CHURCH — Production Backend Environment Configuration
# ==============================================================================

PORT=5000
NODE_ENV=production
APP_URL=https://batuyehiywotberhanchurch.org
FRONTEND_URL=https://batuyehiywotberhanchurch.org

# Application Security
JWT_SECRET=replace_with_a_secure_random_64_character_string_for_production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password

# Database Configuration (SQLite default / PostgreSQL compatible)
DB_PATH=/app/data/church_database.sqlite

# ==============================================================================
# Local Ethiopian Payment Gateway — Chapa (Telebirr, CBE Birr, Awash, Coopbank)
# Dashboard: https://dashboard.chapa.co/
# ==============================================================================
# Test Mode: Use keys beginning with CHASECK_TEST- / CHAPUBK_TEST-
# Live Mode: Use keys beginning with CHASECK- / CHAPUBK-
CHAPA_MODE=test
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Set this to the Webhook Secret defined in your Chapa Dashboard -> Webhooks
# This is required to cryptographically verify incoming x-chapa-signature HMACs
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_key

# ==============================================================================
# International Payment Gateway — Stripe (USD Credit/Debit Cards, Apple Pay)
# Dashboard: https://dashboard.stripe.com/
# ==============================================================================
STRIPE_SECRET_KEY=sk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
